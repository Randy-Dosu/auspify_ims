frontend/node_modules/
frontend/dist/

# ---- Editors & OS ----
.vscode/
.idea/
.DS_Store

# ---- SQLite database files (created at runtime) ----
backend/instance/
*.db
*.db-wal
*.db-shm

# ---- Test caches ----
.pytest_cache/
